<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Timesheet"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="#111827"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Qatar Time • Asia/Qatar"
            android:textSize="14sp"
            android:textColor="#6B7280"/>

        <TextView
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="--:--:--"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:paddingTop="28dp"/>

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:paddingBottom="20dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No punch yet today."
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#111827"
            android:background="#E5E7EB"
            android:padding="14dp"/>

        <Button
            android:id="@+id/punchIn"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="PUNCH IN"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16A34A"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/punchOut"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="PUNCH OUT"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/exportWord"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="EXPORT THIS MONTH"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginTop="22dp"/>

        <TextView
            android:id="@+id/recordsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This Month"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#111827"
            android:layout_marginTop="26dp"/>

        <TextView
            android:id="@+id/records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No records yet."
            android:textSize="15sp"
            android:textColor="#374151"
            android:lineSpacingExtra="5dp"
            android:paddingTop="10dp"
            android:paddingBottom="30dp"/>

    </LinearLayout>
</ScrollView>
